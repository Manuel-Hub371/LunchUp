# ------------------------------------------------------------------
# LunchUp API — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ------------------------------------------------------------------

# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lunchup?schema=public
# Used by e2e tests only
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lunchup_test?schema=public

# Redis (optional at runtime; BullMQ/realtime adapters enabled when set)
REDIS_URL=redis://localhost:6379

# Auth / JWT
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-minimum
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cloudinary (optional; local disk storage used when CLOUDINARY_URL is empty)
CLOUDINARY_URL=

# Payments – test provider credentials (no real money is moved by default)
PAYMENT_MOMO_ACCOUNT_BUILDER=
PAYMENT_CARD_GATEWAY=

# Logging
LOG_LEVEL=info

# Throttling (requests per minute per IP; auth endpoints use a tighter limit)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=20

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5